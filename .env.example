# Banco de Dados

DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
DB_HOST=db
DB_PORT=5432
DB_SSL_MODE=disable

# Configuração de e-mail

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=epson.com.br
EMAIL_PORT=465
EMAIL_HOST_USER=epson@epson.com.br
EMAIL_HOST_PASSWORD=passwd
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=epson@epson.com.br
GENERATIVE_FROM_EMAIL=acesso@generative.com.br
REGISTRATION_REVIEW_EMAIL=atendimento@generative.com.br

# Posthog

POSTHOG_KEY=integrationkey
POSTHOG_URL=https://posthog.cep

# Endereço público usado nos links codificados pelos QR Codes do Match.
# Troque por outro domínio HTTPS quando o proxy/domínio público mudar.
QR_CODE_BASE_URL=https://direct.ddns.net
